#!/usr/bin/env bash
# sync-mcp [checkout] — copy the canonical kg MCP modules (mcp/*.mjs) into <checkout>/kg/ and print sha256 of both sides.
#   default checkout: /home/olson/src/warelab/gramene-mcp-kg (the staging clone, branch kg-tools).
#   The live checkout /home/olson/src/warelab/gramene-mcp is refused unless --allow-live (M3 fold-in only).
set -euo pipefail
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../mcp" && pwd)"
LIVE=/home/olson/src/warelab/gramene-mcp
# compare physical paths: a symlink (or symlinked parent) to the live checkout must not slip past the guard
LIVE_P="$(cd "$LIVE" 2>/dev/null && pwd -P || echo "$LIVE")"
ALLOW_LIVE=0; DEST=/home/olson/src/warelab/gramene-mcp-kg
for a in "$@"; do case "$a" in --allow-live) ALLOW_LIVE=1 ;; -h|--help) sed -n 2,4p "$0"; exit 0 ;; *) DEST="$a" ;; esac; done
DEST="$(cd "$DEST" && pwd -P)"
[ -f "$DEST/server.mjs" ] || { echo "sync-mcp: $DEST has no server.mjs (not a gramene-mcp checkout)" >&2; exit 2; }
if { [ "$DEST" = "$LIVE_P" ] || [ "$DEST" -ef "$LIVE_P" ]; } && [ "$ALLOW_LIVE" != 1 ]; then echo "sync-mcp: refusing the live checkout $LIVE (pass --allow-live at the scheduled fold-in)" >&2; exit 2; fi
if [ -L "$DEST/kg" ]; then echo "sync-mcp: $DEST/kg is a symlink; refusing to copy through it" >&2; exit 2; fi
mkdir -p "$DEST/kg"
rc=0
for f in kg-tools.mjs resources.mjs; do
  t="$DEST/kg/$f"
  # never write through a link: a symlinked or hard-linked file could point into the live checkout
  if [ -L "$t" ] || { [ -e "$t" ] && [ "$(stat -c %h "$t")" != 1 ]; }; then echo "sync-mcp: $t is a symlink or hard link; refusing" >&2; exit 2; fi
  cp -p --remove-destination "$SRC/$f" "$t"
  a=$(sha256sum "$SRC/$f" | cut -d' ' -f1); b=$(sha256sum "$DEST/kg/$f" | cut -d' ' -f1)
  [ "$a" = "$b" ] && st=ok || { st=MISMATCH; rc=1; }
  printf '%s  %s\n%s  %s  %s\n' "$a" "$SRC/$f" "$b" "$DEST/kg/$f" "$st"
done
exit $rc
